# Telegram User Client (eilvelia/tdl) - Obtain API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# OpenClaw Chat ID (where to send PR review requests)
OPENCLAW_CHAT_ID=your_openclaw_chat_id_here

# GitHub Token (provided automatically by GitHub Actions)
GITHUB_TOKEN=provided_by_github_actions

# Repository Info
REPO_OWNER=repository_owner
REPO_NAME=repository_name

# Optional: Max tokens for diff (default 8000)
MAX_TOKENS=8000

# Optional: TDLib database and files directories
TDL_DATABASE_DIR=_td_database
TDL_FILES_DIR=_td_files